// Cloudflare Workers config: serve the committed site/ folder as-is.
// No build step runs on Cloudflare; _headers in site/ sets caching.
// worker/index.js only runs for /og/photo.jpg (the daily link-preview image).
{
  "name": "www",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/og/photo.jpg"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Required by `wrangler preview`, which Workers Builds runs for PR branches.
  "previews": {}
}
